; ==============================================================================
; SantientPHP Production Configuration (sph.ini-production)
; ==============================================================================
; Recommended settings for maximum runtime performance and security.

[santientphp]
version = "0.1.0"
default_target = "x86_64-windows"
default_optimization = "3"
color_diagnostics = Off
show_source_context = Off

[paths]
runtime_path = "lib/libsph_runtime.a"
runtime_source = "runtime/core/runtime.c"
include_path = ".;lib;include"

[runtime]
arena_initial_mb = 16
memory_limit = 512M
thread_safety = On

[subsystems]
winhttp_enabled = On
winsqlite3_enabled = On

[debug]
debug_symbols = Off
verbose_codegen = Off

