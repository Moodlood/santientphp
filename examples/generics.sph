<?php

struct Pair<T, U> {
    first: T,
    second: U,
}

fn makePair<T, U>(a: T, b: U): Pair<T, U> {
    return Pair<T, U> { first: a, second: b };
}

fn add<T>(a: T, b: T): T {
    return a + b;
}

fn main(): i32 {
    let p = makePair<i32, i32>(10, 20);
    let sum = add<i32>(p.first, p.second);
    let b = add<i32>(sum, 70);
    println(sum);
    println(b);
    return 0;
}

