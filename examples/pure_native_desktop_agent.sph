<?php

// ============================================================================
// SantientPHP Pure Native Desktop Agent & Embedded Control Plane
// Demonstrates 100% Pure Native Execution (P0 through P3) without C Bridges
// ============================================================================

import "std/core.sph";
import "std/buffer.sph";
import "std/thread.sph";
import "std/net.sph";
import "std/web.sph";

// ============================================================================
// Phase P0: Win32 C Structs, Unions, Sizing, and Direct Input Injection
// ============================================================================

#[repr(C)]
struct MOUSEINPUT {
    dx: i32,
    dy: i32,
    mouseData: u32,
    dwFlags: u32,
    time: u32,
    dwExtraInfo: usize,
}

#[repr(C)]
union InputPayload {
    mi: MOUSEINPUT,
}

#[repr(C)]
struct INPUT {
    type: u32,
    payload: InputPayload,
}

extern "C" fn SendInput(cInputs: u32, pInputs: *INPUT, cbSize: i32): u32;

fn agent_dispatch_mouse_move(norm_x: f64, norm_y: f64): bool {
    let dx_val: i32 = (norm_x * 65535.0) as i32;
    let dy_val: i32 = (norm_y * 65535.0) as i32;

    // MOUSEEVENTF_MOVE (0x0001) | MOUSEEVENTF_ABSOLUTE (0x8000) = 0x8001
    let mi = MOUSEINPUT {
        dx: dx_val,
        dy: dy_val,
        mouseData: 0 as u32,
        dwFlags: 0x8001 as u32,
        time: 0 as u32,
        dwExtraInfo: 0 as usize,
    };
    let payload = InputPayload { mi: mi };
    mut inp = INPUT {
        type: 0 as u32, // INPUT_MOUSE = 0
        payload: payload,
    };

    let cbSize: i32 = sizeof(INPUT) as i32;
    let sent: u32 = SendInput(1 as u32, &inp, cbSize);
    return sent == 1 as u32;
}

// ============================================================================
// Phase P2: Native C Callback & Window Procedure (Topmost Banner Indicator)
// ============================================================================

extern "C" fn DefWindowProcA(hwnd: usize, uMsg: u32, wParam: usize, lParam: usize): usize;

fn BannerWndProc(hwnd: usize, uMsg: u32, wParam: usize, lParam: usize): usize {
    // WM_NCHITTEST = 0x0084 (132). Return HTTRANSPARENT (-1) for click-through
    if (uMsg == 132 as u32) {
        return -1 as usize;
    }
    return DefWindowProcA(hwnd, uMsg, wParam, lParam);
}

// ============================================================================
// Phase P1: Binary Screen Frame Construction (Null-Byte Safe ByteBuffer)
// ============================================================================

fn generate_simulated_screen_frame(width: i32, height: i32): *u8 {
    let header_size: i64 = 54; // 14 byte BITMAPFILEHEADER + 40 byte BITMAPINFOHEADER
    let pixel_bytes: i64 = (width as i64) * (height as i64) * 3;
    let total_size: i64 = header_size + pixel_bytes;

    let frame = buffer_alloc(total_size);

    // BITMAPFILEHEADER: 'BM' magic = 0x42, 0x4D
    buffer_set_u8(frame, 0, 0x42 as u8);
    buffer_set_u8(frame, 1, 0x4D as u8);
    // bfSize
    buffer_set_u32_le(frame, 2, total_size as u32);
    // bfReserved1 & 2 are 0x00 (Null bytes that previously truncated strings)
    buffer_set_u32_le(frame, 6, 0 as u32);
    // bfOffBits = 54
    buffer_set_u32_le(frame, 10, 54 as u32);

    // BITMAPINFOHEADER: biSize = 40
    buffer_set_u32_le(frame, 14, 40 as u32);
    buffer_set_u32_le(frame, 18, width as u32);
    buffer_set_u32_le(frame, 22, height as u32);
    // biPlanes = 1 (offset 26), biBitCount = 24 (offset 28)
    buffer_set_u16_le(frame, 26, 1 as u16);
    buffer_set_u16_le(frame, 28, 24 as u16);
    // biCompression = 0 (BI_RGB)
    buffer_set_u32_le(frame, 30, 0 as u32);
    buffer_set_u32_le(frame, 34, pixel_bytes as u32);

    // Pixel scanlines contain dark channels (0x00 null bytes)
    mut i: i64 = header_size;
    while (i < header_size + 100) {
        buffer_set_u8(frame, i, 0x00 as u8);     // Blue channel (0x00)
        buffer_set_u8(frame, i + 1, 0x00 as u8); // Green channel (0x00)
        buffer_set_u8(frame, i + 2, 0xFF as u8); // Red channel
        i = i + 3;
    }

    return frame;
}

// ============================================================================
// Phase P1 & P3: Background Streaming Thread & In-Process Control Plane
// ============================================================================

fn background_stream_worker(arg: *u8): *u8 {
    let frame = generate_simulated_screen_frame(800, 450);
    println("Background streaming thread started. Frame buffer size:");
    println(buffer_len(frame));
    buffer_free(frame);
    unsafe {
        return 0 as *u8;
    }
}

// ============================================================================
// Main Pure-Native Systems Entry Point
// ============================================================================

fn main(): i32 {
    println("=================================================");
    println(" SantientPHP v0.2.0 Systems Edition Native Proof ");
    println("=================================================");

    // 1. P0: Direct Win32 SendInput Call with Struct/Union
    println("[P0] Dispatching absolute mouse move (0.5, 0.5)...");
    let mouse_ok: bool = agent_dispatch_mouse_move(0.5, 0.5);
    if (mouse_ok) {
        println("     [OK] SendInput dispatched successfully via native Win64 FFI");
    } else {
        println("     [NOTE] SendInput returned false (no virtual desktop attached)");
    }

    // 2. P1: Binary Buffer Null-Byte Safety
    println("[P1] Verifying ByteBuffer binary integrity...");
    let bmp = generate_simulated_screen_frame(800, 450);
    let bmp_len: i64 = buffer_len(bmp);
    let b0: u8 = buffer_get_u8(bmp, 0);
    let b1: u8 = buffer_get_u8(bmp, 1);
    let b6: u8 = buffer_get_u8(bmp, 6); // Null byte in reserved header
    if (b0 == 0x42 as u8 && b1 == 0x4D as u8 && b6 == 0x00 as u8) {
        println("     [OK] BMP headers intact. Null bytes (0x00) preserved perfectly!");
    }
    buffer_free(bmp);

    // 3. P1: Native Threading & Mutex Synchronization
    println("[P1] Spawning concurrent background streaming thread...");
    let m = mutex_create();
    mutex_lock(m);
    unsafe {
        let t = thread_spawn(&background_stream_worker as *u8, 0 as *u8);
        mutex_unlock(m);
        thread_join(t);
    }
    mutex_destroy(m);
    println("     [OK] Background thread and mutex completed cleanly.");

    // 4. P2: Function Pointer C Callback (WNDPROC)
    println("[P2] Verifying address-of C callback function pointer...");
    unsafe {
        let fn_ptr: *u8 = &BannerWndProc as *u8;
        if (fn_ptr != 0 as *u8) {
            println("     [OK] Native WNDPROC function pointer acquired via &BannerWndProc");
        }
    }

    // 5. P3: Embedded Control Plane HTTP & WebSocket Server Engine
    println("[P3] Initializing embedded control plane server engine...");
    let server_fd = server_listen(4000);
    if (server_fd >= 0) {
        println("     [OK] Embedded control plane server listening on port 4000.");
        let has_conn: bool = server_poll(server_fd, 10);
        server_close(server_fd);
        println("     [OK] Socket multiplexer (WSAPoll) verified without blocking.");
    }

    println("=================================================");
    println(" All Systems Features Operational in Pure SPH!   ");
    println("=================================================");
    return 0;
}
