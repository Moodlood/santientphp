<?php

fn sum(s: &[i32]): i32 {
    let mut total = 0;
    let mut i = 0;
    while (i < s.len) {
        total = total + s[i];
        i = i + 1;
    }
    return total;
}

fn main(): i32 {
    let arr: [i32; 5] = [10, 20, 30, 40, 50];
    let sub: &[i32] = arr[1..4];
    let result = sum(sub);
    println(result);
    return 0;
}

