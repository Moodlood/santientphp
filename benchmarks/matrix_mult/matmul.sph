<?php

fn run_matrix(n: i32): i32 {
    mut total: i32 = 0;
    mut i: i32 = 0;
    while (i < n) {
        mut j: i32 = 0;
        while (j < n) {
            mut k: i32 = 0;
            while (k < n) {
                total = total + (i * k + k * j);
                k = k + 1;
            }
            j = j + 1;
        }
        i = i + 1;
    }
    return total;
}

fn main(): i32 {
    let res: i32 = run_matrix(200);
    println(res);
    return 0;
}

