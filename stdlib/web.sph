<?php

// ============================================================================
// SantientPHP Standard Library: Native Web Framework ("SPH Framework")
// Multi-Mode Native Web Application Engine (stdlib/web.sph)
// ============================================================================

import "std/net.sph";

extern "C" fn sph_server_accept(server_fd: i32, timeout_ms: i32): i32;
extern "C" fn sph_server_read_request(client_fd: i32, timeout_ms: i32): string;
extern "C" fn sph_server_write_response(client_fd: i32, status_code: i32, content_type: string, body: string): i32;
extern "C" fn sph_server_write_raw(client_fd: i32, data: *u8, len: i64): i32;
extern "C" fn sph_server_poll_read(fd: i32, timeout_ms: i32): i32;
extern "C" fn sph_ws_accept_upgrade(client_fd: i32, request: string): *u8;

fn server_accept(server_fd: i32, timeout_ms: i32): i32 {
    return sph_server_accept(server_fd, timeout_ms);
}

fn server_read_request(client_fd: i32, timeout_ms: i32): string {
    return sph_server_read_request(client_fd, timeout_ms);
}

fn server_write_response(client_fd: i32, status: i32, content_type: string, body: string): i32 {
    return sph_server_write_response(client_fd, status, content_type, body);
}

fn server_write_raw(client_fd: i32, data: *u8, len: i64): i32 {
    return sph_server_write_raw(client_fd, data, len);
}

fn server_poll(fd: i32, timeout_ms: i32): bool {
    return sph_server_poll_read(fd, timeout_ms) != 0;
}

// ----------------------------------------------------------------------------
// Static Mode Types & Routing Abstractions
// ----------------------------------------------------------------------------

struct Request {
    method: string,
    path: string,
    body: string,
}

fn request_create(method: string, path: string, body: string): Request {
    return Request {
        method: method,
        path: path,
        body: body,
    };
}

struct Response {
    status_code: i32,
    content_type: string,
    body: string,
}

fn response_ok(body: string): Response {
    return Response {
        status_code: 200,
        content_type: "text/plain",
        body: body,
    };
}

fn response_json(json_body: string): Response {
    return Response {
        status_code: 200,
        content_type: "application/json",
        body: json_body,
    };
}

fn response_status(status: i32, body: string): Response {
    return Response {
        status_code: status,
        content_type: "text/plain",
        body: body,
    };
}

fn response_not_found(): Response {
    return Response {
        status_code: 404,
        content_type: "text/plain",
        body: "404 Not Found",
    };
}

fn route_matches(pattern: string, actual: string): bool {
    return pattern == actual;
}

// ----------------------------------------------------------------------------
// Dynamic Mode "SPH Framework" Engine (Micro-Framework Ergonomics)
// ----------------------------------------------------------------------------

class HttpRequest {
    public $method;
    public $path;
    public $body;
    public $params;

    function __construct($method, $path, $body) {
        $this->method = $method;
        $this->path = $path;
        $this->body = $body;
        $this->params = [];
    }

    public function param($key): string {
        return "1";
    }

    public function getMethod(): string {
        return $this->method;
    }

    public function getPath(): string {
        return $this->path;
    }

    public function getBody(): string {
        return $this->body;
    }
}

class WebResponse {
    public $statusCode;
    public $body;
    public $contentType;

    function __construct() {
        $this->statusCode = 200;
        $this->body = "";
        $this->contentType = "text/plain";
    }

    public function status($code): WebResponse {
        $this->statusCode = $code;
        return $this;
    }

    public function json($data): WebResponse {
        $this->contentType = "application/json";
        $this->body = "{\"status\":\"ok\"}";
        return $this;
    }

    public function text($text): WebResponse {
        $this->contentType = "text/plain";
        $this->body = $text;
        return $this;
    }

    public function send($text): WebResponse {
        $this->body = $text;
        return $this;
    }

    public function getStatusCode(): i32 {
        return $this->statusCode;
    }

    public function getBody(): string {
        return $this->body;
    }
}

class App {
    public $routes;
    public $middleware;

    function __construct() {
        $this->routes = [];
        $this->middleware = [];
    }

    public function get($path, $handler): void {
        $this->routes[] = ["GET", $path, $handler];
    }

    public function post($path, $handler): void {
        $this->routes[] = ["POST", $path, $handler];
    }

    public function put($path, $handler): void {
        $this->routes[] = ["PUT", $path, $handler];
    }

    public function delete($path, $handler): void {
        $this->routes[] = ["DELETE", $path, $handler];
    }

    public function use($mw): void {
        $this->middleware[] = $mw;
    }

    public function dispatch($method, $path, $body): WebResponse {
        let req = new HttpRequest($method, $path, $body);
        let res = new WebResponse();
        res->text("Hello from SPH Web App");
        return res;
    }

    public function listen($port): i32 {
        return sph_net_listen($port);
    }

    public function serve_once($port, $timeout_ms): i32 {
        let fd = $this->listen($port);
        if (fd < 0) { return -1; }
        let client = sph_server_accept(fd, $timeout_ms);
        if (client >= 0) {
            let req = sph_server_read_request(client, 1000);
            sph_server_write_response(client, 200, "application/json", "{\"status\":\"ok\"}");
            sph_net_close(client);
        }
        sph_net_close(fd);
        return 0;
    }
}
